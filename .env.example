# === Variables pour query_local_llm.py ===

# URL de l'API locale compatible OpenAI (vLLM, Ollama, LM Studio, LocalAI, oMLX)
# Exemples standards :
# - LM Studio / vLLM / LocalAI : http://127.0.0.1:8000/v1/chat/completions ou http://localhost:1234/v1/chat/completions
# - Ollama (via compatibilité OpenAI v1) : http://localhost:11434/v1/chat/completions
# - oMLX (macOS) : http://127.0.0.1:8000/v1/chat/completions
LOCAL_AI_URL=http://127.0.0.1:8000/v1/chat/completions

# Nom du modèle configuré localement à appeler
# Exemples : phi-4, llama3, Qwen3.5-9B-MLX-4bit, mlx-community/phi-4-4bit, etc.
LOCAL_AI_MODEL=mlx-community/phi-4-4bit

# Temps d'attente maximum en secondes avant abandon et fallback automatique sur Cloud
LOCAL_AI_TIMEOUT=60

# Clé API locale (optionnelle, laisser vide si non requise)
LOCAL_AI_API_KEY=

# === Variables pour deploy_api.sh ===

# Backend à utiliser pour le déploiement (omlx, ollama, vllm)
# Laisser vide pour détection automatique
LOCAL_AI_BACKEND=

# Port du serveur local (défaut: 8000 pour oMLX/vLLM, 11434 pour Ollama)
LOCAL_AI_PORT=8000

# Chemin de base oMLX (défaut: ~/.omlx)
# LOCAL_AI_BASE_PATH=~/.omlx

# vLLM uniquement : mémoire GPU allouée (défaut: 0.9 = 90%)
# LOCAL_AI_GPU_MEM=0.9

# vLLM uniquement : tensor parallelism (défaut: 1)
# LOCAL_AI_TENSOR_PARALLEL=1
